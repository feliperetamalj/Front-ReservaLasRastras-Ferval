# Variables de la agenda de visitas. Van en Vercel (Settings → Environment
# Variables), nunca en este repositorio ni en el código del navegador.
# Si falta cualquiera, la agenda se apaga sola y /agendar envía por WhatsApp.

# Supabase → Project Settings → API
SUPABASE_URL=
# Supabase → Project Settings → API Keys → secret (sb_secret_…) o service_role
SUPABASE_SERVICE_ROLE_KEY=

# Cuenta de Gmail que envía los correos (el visitante la ve como remitente)
SMTP_USUARIO=
# Contraseña de aplicación de esa cuenta, sin espacios (no la contraseña normal):
# myaccount.google.com/apppasswords, con la verificación en dos pasos activa
SMTP_CLAVE=
# A quién le llegan las solicitudes nuevas (la sala de ventas)
AGENDA_CORREO_SALA=

# Texto largo al azar para la huella de la IP; genéralo con: openssl rand -hex 32
HASH_SALT=

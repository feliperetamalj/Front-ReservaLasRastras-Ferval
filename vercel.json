{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "gru1"
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/modelos/mediterranea-179-2pisos.html",
      "destination": "/modelos/mediterranea-179",
      "statusCode": 301
    },
    {
      "source": "/modelos/mediterranea-179-2pisos",
      "destination": "/modelos/mediterranea-179",
      "statusCode": 301
    },
    {
      "source": "/reserva/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/reserva",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/visitasaladeventa/",
      "destination": "/agendar",
      "statusCode": 301
    },
    {
      "source": "/visitasaladeventa",
      "destination": "/agendar",
      "statusCode": 301
    },
    {
      "source": "/assets/docs/brochure-reserva-las-rastras-2026.pdf",
      "destination": "/docs/brochure-reserva-las-rastras-2026.pdf",
      "statusCode": 301
    },
    {
      "source": "/(.*)\\.html",
      "destination": "/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)/",
      "destination": "/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
